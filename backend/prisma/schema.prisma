generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MatchStatus {
  UPCOMING
  LIVE
  FT
  POSTPONED
  CANCELLED
}

enum EventType {
  GOAL
  OWN_GOAL
  PENALTY
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
}

enum Side {
  HOME
  AWAY
}

enum MediaCategory {
  TEAM_LOGO
  PLAYER_PHOTO
  NEWS_COVER
  COMPETITION_LOGO
  HOMEPAGE
  OTHER
}

model AdminUser {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  username     String?    @unique
  passwordHash String
  role         Role       @default(EDITOR)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  lastLoginAt  DateTime?

  logs ActivityLog[]

  @@map("admin_users")
}

model Competition {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  shortName   String?
  country     String?
  region      String
  level       String?
  type        String?
  season      String?
  description String?
  logo        String?
  color       String?
  status      PublicationStatus @default(PUBLISHED)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  teams   Team[]
  matches Match[]
  seasons Season[]
}

model Season {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  competitionId Int?
  competition  Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("seasons")
}

model City {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String?
  region      String
  cityType    String?
  subcity     String?
  woreda      String?
  kebele      String?
  logo        String?
  description String?
  latitude    Float?
  longitude   Float?
  isFeatured  Boolean  @default(false)
  status      PublicationStatus @default(PUBLISHED)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Team {
  id            Int         @id @default(autoincrement())
  name          String      @unique
  shortName     String?
  slug          String?
  city          String
  region        String?
  competitionId Int?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  division      String?
  type          String?
  position      Int?
  form          String?
  logo          String?
  color         String?
  founded       Int?
  stadium       String?
  capacity      Int?
  league        String?
  description   String?
  homeJersey    String?
  awayJersey    String?
  website       String?
  facebook      String?
  telegram      String?
  instagram     String?
  phone         String?
  email         String?
  isFeatured    Boolean     @default(false)
  published     Boolean     @default(true)
  status        PublicationStatus @default(PUBLISHED)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  players      Player[]
  homeMatches  Match[] @relation("HomeTeamMatches")
  awayMatches  Match[] @relation("AwayTeamMatches")

  @@index([competitionId])
}

model Player {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String?
  teamId        Int
  team          Team     @relation(fields: [teamId], references: [id])
  position      String?
  dateOfBirth   DateTime?
  age           Int?
  nationality   String?
  city          String?
  height        String?
  weight        Int?
  preferredFoot String?
  jerseyNumber  Int?
  playerStatus  String?
  photo         String?
  biography     String?
  instagram     String?
  isFeatured    Boolean  @default(false)
  status        PublicationStatus @default(PUBLISHED)
  goals         Int      @default(0)
  assists       Int      @default(0)
  matches       Int      @default(0)
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)
  minutesPlayed Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events MatchEvent[]

  @@index([teamId])
}

model Match {
  id            Int         @id @default(autoincrement())
  competitionId Int?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  season        String?
  division      String?
  homeTeamId    Int
  awayTeamId    Int
  homeTeam      Team        @relation("HomeTeamMatches", fields: [homeTeamId], references: [id])
  awayTeam      Team        @relation("AwayTeamMatches", fields: [awayTeamId], references: [id])
  homeScore     Int?
  awayScore     Int?
  status        MatchStatus @default(UPCOMING)
  minute        Int?
  date          DateTime
  timeField     String?     @map("time")
  venue         String?
  referee       String?
  attendance    Int?
  isLive        Boolean     @default(false)
  isFinished    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  events     MatchEvent[]
  lineups    MatchLineup[]
  statistics MatchStatistic[]

  @@index([competitionId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([date])
}

model MatchEvent {
  id        Int       @id @default(autoincrement())
  matchId   Int
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type      EventType
  side      Side
  minute    Int?
  playerId  Int?
  player    Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerName String?
  assist    String?
  playerIn  String?
  playerOut String?
  createdAt DateTime  @default(now())

  @@index([matchId])
}

model MatchLineup {
  id          Int     @id @default(autoincrement())
  matchId     Int
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  side        Side
  formation   String?
  startingXI  Json?
  substitutes Json?
  createdAt   DateTime @default(now())

  @@unique([matchId, side])
  @@index([matchId])
}

model MatchStatistic {
  id        Int    @id @default(autoincrement())
  matchId   Int    @unique
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  possession Int?
  shots     Int?
  shotsOnTarget Int?
  corners   Int?
  fouls     Int?
  offside   Int?
  saves     Int?
  yellowCards Int?
  redCards  Int?
  passes    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("match_statistics")
}

model NewsArticle {
  id          Int               @id @default(autoincrement())
  title       String
  slug        String            @unique
  summary     String?
  content     String?
  category    String?
  author      String?
  coverImage  String?
  publishedAt DateTime?
  status      PublicationStatus @default(DRAFT)
  featured    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

model Media {
  id        Int           @id @default(autoincrement())
  filename  String
  url       String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  category  MediaCategory @default(OTHER)
  createdAt DateTime      @default(now())

  @@index([category])
}

model WebsiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model HomepageSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model Favorite {
  id          Int      @id @default(autoincrement())
  type        String
  referenceId Int
  name        String?
  createdAt   DateTime @default(now())

  @@unique([type, referenceId])
}

model ActivityLog {
  id        Int          @id @default(autoincrement())
  action    String
  entity    String?
  entityId  Int?
  userId    Int?
  user      AdminUser?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([createdAt])
}